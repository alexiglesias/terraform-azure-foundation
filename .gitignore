# Terraform
.terraform/
# NOTE: .terraform.lock.hcl is deliberately NOT ignored - commit it, so
# everyone (and CI) resolves the exact same provider versions.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
plan.txt
crash.log
crash.*.log

# Backend settings generated by bootstrap/ - contain your subscription's
# storage account name, so they stay out of the repo
backend.hcl

# Your own values (IP address, email, SSH public key)
*.auto.tfvars
terraform.tfvars
.env

# OS / editor noise
.DS_Store
.vscode/

# Lock files belong to root configurations (bootstrap, envs/*), not modules
modules/**/.terraform.lock.hcl
