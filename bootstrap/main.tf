# ---------------------------------------------------------------------------
# Remote state storage for envs/dev
# ---------------------------------------------------------------------------

data "azurerm_client_config" "current" {}
data "azurerm_subscription" "current" {}

locals {
  # Storage account names are global across all Azure customers: 3-24
  # characters, lowercase letters and digits only. Part of the subscription
  # ID makes this one unique without random suffixes.
  state_account_name = "st${substr(replace(var.subscription_id, "-", ""), 0, 10)}tfstate"

  tags = {
    project     = var.project_name
    environment = "bootstrap"
    managed_by  = "terraform"
    cost_center = "portfolio"
  }
}

resource "azurerm_resource_group" "state" {
  name     = "rg-${var.project_name}-tfstate"
  location = var.location
  tags     = local.tags
}

resource "azurerm_storage_account" "state" {
  # checkov:skip=CKV_AZURE_33:No queues are used - state lives in blob storage. Queue logging also needs a billed log destination.
  # checkov:skip=CKV_AZURE_59:The laptop and GitLab shared runners must reach the state over the internet. Access still needs an Entra ID login with a data role - account keys are off.
  # checkov:skip=CKV2_AZURE_33:Private endpoints are billed hourly, and the laptop and GitLab shared runners could not reach one anyway.
  # checkov:skip=CKV2_AZURE_1:Customer-managed keys need a Key Vault key with purge protection. Microsoft-managed encryption plus infrastructure encryption are on.
  # checkov:skip=CKV_AZURE_206:LRS is the only free-tier option. Versioning + 7-day soft delete cover recovery of the state file.
  name                     = local.state_account_name
  resource_group_name      = azurerm_resource_group.state.name
  location                 = azurerm_resource_group.state.location
  account_kind             = "StorageV2"
  account_tier             = "Standard"
  account_replication_type = "LRS" # the free allowance is LRS only

  https_traffic_only_enabled        = true     # refuse plain HTTP
  min_tls_version                   = "TLS1_2" # refuse old, weak TLS
  allow_nested_items_to_be_public   = false    # no container can ever be made public
  shared_access_key_enabled         = false    # no account keys: Entra ID logins only
  default_to_oauth_authentication   = true     # the portal uses your login too
  infrastructure_encryption_enabled = true     # a second layer of encryption at rest, free
  local_user_enabled                = false    # no SFTP/local-user logins either

  blob_properties {
    versioning_enabled = true # every state change is kept, so a bad apply can be rolled back

    delete_retention_policy {
      days = 7 # a deleted state file can be recovered for 7 days
    }

    container_delete_retention_policy {
      days = 7
    }
  }

  tags = local.tags

  # State is the one thing you never want to lose by accident.
  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_storage_container" "state" {
  # checkov:skip=CKV2_AZURE_21:Blob read logging needs diagnostic settings sending to a billed destination (Log Analytics). Versioning already records every state change.
  name                  = "tfstate"
  storage_account_id    = azurerm_storage_account.state.id
  container_access_type = "private"

  # The container holds every state file - never delete it by accident.
  lifecycle {
    prevent_destroy = true
  }
}

# Old state versions are only useful for a while - delete them so the
# account doesn't grow forever (and stays inside the free 5 GB).
resource "azurerm_storage_management_policy" "state" {
  storage_account_id = azurerm_storage_account.state.id

  rule {
    name    = "expire-old-state-versions"
    enabled = true

    filters {
      blob_types = ["blockBlob"]
    }

    actions {
      version {
        delete_after_days_since_creation = 90
      }
    }
  }
}

# With account keys switched off, even the owner needs a data role to read
# and write blobs. This gives YOU (whoever runs this) access to the state.
resource "azurerm_role_assignment" "state_me" {
  scope                = azurerm_storage_account.state.id
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = data.azurerm_client_config.current.object_id
}

# Write the backend settings for envs/dev, so nobody copies an account name
# by hand. The file is gitignored (the name contains part of your
# subscription ID).
resource "local_file" "dev_backend_config" {
  filename        = "${path.root}/../envs/dev/backend.hcl"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by bootstrap/ - do not edit, do not commit.
    subscription_id      = "${var.subscription_id}"
    resource_group_name  = "${azurerm_resource_group.state.name}"
    storage_account_name = "${azurerm_storage_account.state.name}"
    container_name       = "${azurerm_storage_container.state.name}"
    use_azuread_auth     = true
  EOT
}

# ---------------------------------------------------------------------------
# Budget alert. Lives here, not in envs/dev, so it keeps watching after
# `terraform destroy` - which is exactly when a forgotten resource hurts.
# It alerts, it does NOT stop spend (the free trial's spending limit does
# that for the first 30 days).
# ---------------------------------------------------------------------------

resource "azurerm_consumption_budget_subscription" "monthly" {
  name            = "budget-${var.project_name}-monthly"
  subscription_id = data.azurerm_subscription.current.id
  amount          = var.budget_amount
  time_grain      = "Monthly"

  time_period {
    # Azure wants the first day of a month. Computed once at creation;
    # ignore_changes below stops it showing as a change every month.
    start_date = formatdate("YYYY-MM-01'T'00:00:00Z", timestamp())
  }

  notification {
    enabled        = true
    threshold      = 80
    operator       = "GreaterThan"
    threshold_type = "Actual"
    contact_emails = [var.budget_alert_email]
  }

  notification {
    enabled        = true
    threshold      = 100
    operator       = "GreaterThan"
    threshold_type = "Actual"
    contact_emails = [var.budget_alert_email]
  }

  # Fires on the forecast, so a forgotten resource is flagged before the
  # money is spent, not after.
  notification {
    enabled        = true
    threshold      = 100
    operator       = "GreaterThan"
    threshold_type = "Forecasted"
    contact_emails = [var.budget_alert_email]
  }

  lifecycle {
    ignore_changes = [time_period]
  }
}
