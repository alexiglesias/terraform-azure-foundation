data "azurerm_client_config" "current" {}

resource "random_string" "suffix" {
  length  = 6
  upper   = false
  special = false
}

# ---------------------------------------------------------------------------
# The vault
# ---------------------------------------------------------------------------

# Not prevent_destroy: this is a disposable dev vault, and step 9 of the
# project is `terraform destroy` + proving nothing is left.
# tflint-ignore: azurerm_resources_missing_prevent_destroy
resource "azurerm_key_vault" "this" {
  # checkov:skip=CKV_AZURE_42:Soft delete is on (7 days); only purge protection is off - see CKV_AZURE_110.
  # checkov:skip=CKV_AZURE_110:Purge protection would block `terraform destroy` from removing this disposable dev vault for up to 90 days. Turn it on in production.
  name                = "kv-${var.short_name}-${random_string.suffix.result}"
  location            = var.location
  resource_group_name = var.resource_group_name
  tenant_id           = data.azurerm_client_config.current.tenant_id
  sku_name            = "standard" # premium/HSM cost more; not needed here

  # Who can do what is decided by Azure role assignments (RBAC), the same
  # system as everything else in Azure - not by the vault's own old-style
  # access policies.
  rbac_authorization_enabled = true

  soft_delete_retention_days = 7     # minimum; a deleted vault can be recovered for 7 days
  purge_protection_enabled   = false # so `terraform destroy` really removes a disposable dev vault

  # Firewall: only your laptop's IP and the web subnet get through.
  network_acls {
    default_action             = "Deny"
    bypass                     = "AzureServices"
    ip_rules                   = var.allowed_ip_addresses
    virtual_network_subnet_ids = var.allowed_subnet_ids
  }

  tags = var.tags
}

# ---------------------------------------------------------------------------
# Who may write secrets
# ---------------------------------------------------------------------------

resource "azurerm_role_assignment" "secret_officer" {
  for_each = var.secret_officer_principal_ids

  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = each.value
}

# New role assignments take a minute or two to work everywhere in Azure.
# Without this wait, the first apply often fails writing the secret with 403.
resource "time_sleep" "rbac_propagation" {
  depends_on      = [azurerm_role_assignment.secret_officer]
  create_duration = "90s"
}

# ---------------------------------------------------------------------------
# The demo secret
#
# The password is generated by an *ephemeral* resource and sent with a
# *write-only* argument: Terraform passes it to Azure and forgets it. It is
# never written to the plan file or the state.
# ---------------------------------------------------------------------------

ephemeral "random_password" "secret" {
  length  = 24
  special = true
}

# Not prevent_destroy: a demo secret that can be regenerated any time by
# bumping secret_version.
# tflint-ignore: azurerm_resources_missing_prevent_destroy
resource "azurerm_key_vault_secret" "this" {
  name             = var.secret_name
  key_vault_id     = azurerm_key_vault.this.id
  value_wo         = ephemeral.random_password.secret.result
  value_wo_version = var.secret_version
  content_type     = "password"
  expiration_date  = var.secret_expiration_date

  depends_on = [time_sleep.rbac_propagation]
}
